# Generated by Cargo
# will have compiled files and executables
/target/

# macOS 打包产物（scripts/build_macos.sh 生成）
/build/

# Remove Cargo.lock if you're not tracking dependencies for a library
# (libraries typically don't commit Cargo.lock to avoid locking versions for users)
# For binaries/applications, it's recommended to commit Cargo.lock
# Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows build artifacts
*.pdb

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Build/coverage output
/coverage/
*.profraw

# Local env / secrets
.env
.env.local
